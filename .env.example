# ============================================================
# La Finca Eco Hotel — Plantilla de variables de entorno
# Copia este archivo como `.env.local` y completa los valores.
# `.env.local` NUNCA se sube al repositorio.
# ============================================================

# --- Supabase (proyecto de La Finca) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor — jamás exponer al navegador
SUPABASE_SERVICE_ROLE_KEY=

# Conexión directa a Postgres (migraciones y scripts)
SUPABASE_DB_URL=

# --- Sitio ---
# Dirección canónica, SIN barra final. La usan las etiquetas <link rel=canonical>,
# OpenGraph, el sitemap y el robots.txt: si en Vercel queda sin definir, el sitio
# publicado se declarará canónico en localhost. Debe configurarse en el proyecto
# de Vercel (primero la URL temporal, y al final lafincaecohotel.com).
NEXT_PUBLIC_SITE_URL=

# Optimización de imágenes de Vercel. Déjala VACÍA o sin definir: el sitio se
# publica SIN transformaciones, y ese es el modo normal (decisión de Cesar,
# 2026-09-14).
#
# Por qué: el plan de Vercel incluye un número limitado de transformaciones de
# Image Optimization al mes y, cuando se agota, NO sirve la foto sin optimizar:
# devuelve un error y el sitio se queda con los huecos de las imágenes vacíos.
# Un hotel cuyo producto es la fotografía no puede depender de eso.
#
# El peso lo controlamos nosotros: `npm run imagenes:variantes` genera las
# variantes por ancho en el bucket y `<Foto>` arma el `srcset` con los `sizes`
# reales de cada uso. Si se cambia el catálogo de fotos, hay que volver a
# correrlo (y luego `npm run imagenes:limpiar` para barrer lo que sobre).
#
# Poner `0` —y SOLO `0`— vuelve a encender `/_next/image`. Sirve para comparar
# los dos modos; no es el estado de publicación.
IMAGENES_SIN_OPTIMIZAR=

# Interruptor de publicación real del sitio.
#
# Mientras el WordPress viejo siga siendo la web en producción, la URL de
# Vercel —la temporal (`…vercel.app`) o cualquier preview— NO puede
# indexarse: competiría por las mismas búsquedas que el dominio real y le
# robaría posicionamiento a lafincaecohotel.com. Con esta variable ausente o
# distinta de `1` (el valor por defecto, pensado para durar todo el desarrollo
# y el primer deploy), `robots.txt` bloquea el sitio COMPLETO
# (`Disallow: /`) y cada página se publica con `noindex, nofollow`.
# Se pone en `1` el mismo día que el dominio apunte a Vercel y el WordPress
# deje de estar en producción —nunca antes—, y se redespliega. Dejarla en `0`
# después del lanzamiento significa que Google nunca va a indexar el sitio.
SITIO_PUBLICADO=

# --- Google Places (reseñas de la ficha del hotel) ---
# Solo servidor — jamás exponer al navegador (es una clave facturable).
# En el proyecto de Google Cloud SOLO está habilitada la Places API (New)
# (`places.googleapis.com/v1/...`). La API clásica de Places responde
# REQUEST_DENIED, así que no debe usarse. Sin esta variable el bloque de
# reseñas simplemente no se publica: el sitio sigue funcionando igual.
GOOGLE_PLACES_API_KEY=

# --- Wompi (pendiente — fase de pagos, usar sandbox primero) ---
# NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
# WOMPI_PRIVATE_KEY=
# WOMPI_INTEGRITY_SECRET=
# WOMPI_EVENTS_SECRET=

# --- Resend (pendiente — correos transaccionales) ---
# RESEND_API_KEY=
# EMAIL_FROM=
